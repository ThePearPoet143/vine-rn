{
  "cli": {
    "version": ">= 16.20.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "qa": {
      "distribution": "internal",
      "env": {
        "APP_ENV": "qa"
      },
      "channel": "qa"
    },
    "preview": {
      "distribution": "internal"
    },
    "production": {
      "autoIncrement": true,
      "channel": "production"
    }
  },
  "submit": {
    "qa": {
      "ios": {
        "appleTeamId": "Y6R3HG9MDT"
      }
    },
    "production": {
      "ios": {
        "appleTeamId": "Y6R3HG9MDT"
      }
    }
  }
}
